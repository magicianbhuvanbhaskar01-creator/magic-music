rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Settings doc: public read, admin write
    match /settings/{docId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.email == 'bhuvanbhaskar924@gmail.com';
    }

    // Tracks collection: public read, admin write
    match /tracks/{trackId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null && request.auth.token.email == 'bhuvanbhaskar924@gmail.com';
    }

    // Default: allow reads, deny writes
    match /{document=**} {
      allow read: if true;
      allow write: if false;
    }
  }
}
